# 
# Loan Service — Environment Configuration Template
# 
# Salin berkas ini ke .env dan isi nilainya sesuai lingkungan lokal Anda.
# JANGAN commit berkas .env ke repositori Git.
# 

# Port tempat Layanan Peminjaman berjalan
LOAN_PORT=3002

# Kunci rahasia untuk penandatanganan dan verifikasi token JWT (algoritma HS256)
# Harus identik dengan nilai JWT_SECRET pada Catalog Service
# Gunakan string acak yang kuat, minimal 32 karakter
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_dan_panjang

# Masa berlaku token JWT (format: angka dalam detik, atau string seperti "1h", "7d")
JWT_EXPIRES_IN=1h

# Base URL Layanan Katalog untuk pemanggilan inter-service
CATALOG_BASE_URL=http://localhost:3001

# Path ke berkas basis data SQLite peminjaman
# Relatif terhadap root direktori loan-service/
DB_PATH=./data/loan.db

# 
# Kredensial Seed Data (hanya dipakai saat menjalankan: node data/seed.js)
# Password ini adalah data uji yang sudah terdokumentasi di PRD.md 
# 
SEED_ADMIN_PASSWORD="Admin#Pass2026"
SEED_MHS_BUDI_PASSWORD="Budi#Pass2026"
SEED_MHS_SARI_PASSWORD="Sari#Pass2026"
