# 
# Catalog Service — Environment Configuration Template
# 
# Salin berkas ini ke .env dan isi nilainya sesuai lingkungan lokal Anda.
# JANGAN commit berkas .env ke repositori Git.
# 

# Port tempat Layanan Katalog berjalan
CATALOG_PORT=3001

# Kunci rahasia untuk verifikasi tanda tangan JWT (harus sama dengan Loan Service)
# Gunakan string acak yang kuat, minimal 32 karakter
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_dan_panjang

# Path ke berkas basis data SQLite katalog
# Relatif terhadap root direktori catalog-service/
DB_PATH=./data/catalog.db
